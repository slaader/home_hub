# Home Hub: runs home-hub-security-collect.service every 24 hours. The interval matches what the hub expects
# (server/collector-state.mjs): a snapshot older than a quarter over this interval is shown as stale.
[Unit]
Description=Home Hub: security-collect every 24 hours

[Timer]
OnBootSec=10min
OnUnitActiveSec=24h
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
