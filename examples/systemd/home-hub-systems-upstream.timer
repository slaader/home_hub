# Home Hub: runs home-hub-systems-upstream.service every 12 hours. The interval matches what the hub expects
# (server/collector-state.mjs): a snapshot older than a quarter over this interval is shown as stale.
[Unit]
Description=Home Hub: systems-upstream every 12 hours

[Timer]
OnBootSec=5min
OnUnitActiveSec=12h
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
