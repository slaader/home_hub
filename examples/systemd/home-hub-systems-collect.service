# Home Hub: collect OS and software versions and host protection over SSH
# A user unit. Copy it to ~/.config/systemd/user/ together with its timer and adjust the two paths
# below: the checkout (WorkingDirectory) and the data directory the server reads (--data = its DATA_DIR).
# The collector is read-only on the machines it probes. See examples/systemd/README.md.
[Unit]
Description=Home Hub: collect OS and software versions and host protection over SSH

[Service]
Type=oneshot
# Lets the snapshot say which unit wrote it (the page shows "scheduled by systemd").
Environment=HOME_HUB_UNIT=%n
WorkingDirectory=%h/home-hub
ExecStart=/usr/bin/env node scripts/collect-systems.mjs --data %h/home-hub/data
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
# Probes need the user's ssh config and keys. With an ssh-agent:  Environment=SSH_AUTH_SOCK=%t/ssh-agent.socket
