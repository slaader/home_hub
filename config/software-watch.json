  {"id": "claude-code", "name": "Claude Code", "category": "agents", "upstream": {"type": "npm", "package": "@anthropic-ai/claude-code", "tag": "latest"}, "detect": {"studio": {"kind": "cmd", "path": "~/.local/bin/claude", "args": "--version", "source": {"label": "Claude native installer", "url": "https://www.npmjs.com/package/@anthropic-ai/claude-code"}}, "mini": {"kind": "cmd", "path": "~/.local/bin/claude", "args": "--version", "source": {"label": "Claude native installer", "url": "https://www.npmjs.com/package/@anthropic-ai/claude-code"}}}},
  {"id": "codex", "name": "Codex CLI", "category": "agents", "upstream": {"type": "npm", "package": "@openai/codex", "tag": "latest"}, "detect": {"studio": {"kind": "cmd", "path": "/opt/homebrew/bin/codex", "args": "--version", "source": {"label": "npm global (Homebrew node)", "url": "https://www.npmjs.com/package/@openai/codex"}}, "mini": {"kind": "cmd", "path": "~/.local/bin/codex", "args": "--version", "source": {"label": "Codex standalone installer", "url": "https://github.com/openai/codex/releases"}}}},
  {"id": "opencode", "name": "OpenCode", "category": "agents", "upstream": {"type": "github", "repo": "anomalyco/opencode", "tagPattern": "^v?\\d+\\.\\d+\\.\\d+$"}, "detect": {"studio": {"kind": "brew", "formula": "opencode", "upstream": {"type": "brew-formula", "name": "opencode"}}, "mini": {"kind": "cmd", "path": "~/.opencode/bin/opencode", "args": "--version", "source": {"label": "OpenCode standalone installer", "url": "https://github.com/anomalyco/opencode/releases"}}}},
